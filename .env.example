# Copy to .env (git-ignored). NEVER put access keys in this file --
# use an AWS profile (aws configure sso / aws configure --profile ...) or an IAM role.
CLOUDPOSTURE_PROFILE=cloudposture-readonly
CLOUDPOSTURE_HOME_REGION=us-east-1
# Comma-separated; leave empty to scan every enabled region
CLOUDPOSTURE_REGIONS=
# Optional: assume a read-only role (sts:AssumeRole) instead of using the profile directly
CLOUDPOSTURE_ROLE_ARN=
# Thresholds (CIS defaults shown)
CLOUDPOSTURE_MAX_KEY_AGE_DAYS=90
CLOUDPOSTURE_MAX_UNUSED_DAYS=45
CLOUDPOSTURE_MIN_PASSWORD_LENGTH=14
CLOUDPOSTURE_PASSWORD_REUSE=24
